FROM alpine:3.23.3

RUN apk add --no-cache nmap=7.98-r0 coreutils=9.9-r0 \
    && addgroup -S -g 65532 sandbox \
    && adduser -S -D -H -u 65532 -G sandbox sandbox \
    && mkdir -p /workspace \
    && chown 65532:65532 /workspace

USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["sleep", "infinity"]
