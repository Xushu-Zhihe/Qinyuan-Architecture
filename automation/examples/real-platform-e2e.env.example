# Opt-in guard: both flags are required before any network request is made.
AUTOMATION_PLATFORM_E2E=1
AUTOMATION_PLATFORM_ISOLATED=1

# Use a manifest created for a non-production competition fixture.
AUTOMATION_PLATFORM_MANIFEST=E:\path\to\isolated-manifest.json
AUTOMATION_PLATFORM_TOKEN=REPLACE_IN_CURRENT_POWERSHELL_SESSION_ONLY
AUTOMATION_PLATFORM_TIMEOUT_SECONDS=60

# These IDs must already exist in the manifest; the test never guesses endpoints.
AUTOMATION_FETCH_OPERATION_ID=fetch-question
AUTOMATION_SUBMIT_OPERATION_ID=submit-answer

# The fetch decision describes the documented response shape for this fixture.
AUTOMATION_FETCH_DECISION_JSON={"status":"question","message":"fetched","question":{"external_id":"fixture-question","name":"Fixture question","goal":"Solve the fixture","origin":"isolated fixture","hints":[]},"metadata":{}}

# Workgroup result supplied by the isolated fixture/test operator.
AUTOMATION_WORKGROUP_RESULT_JSON={"fact":{"content":"REPLACE_FIXTURE_ANSWER"}}

# Optional variables for templates not covered by answer_mapping.
AUTOMATION_SUBMIT_VARIABLES_JSON={}
