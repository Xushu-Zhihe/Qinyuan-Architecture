{
  "execution": {
    "backend": "local"
  },
  "tool_sandbox": {
    "enabled": true,
    "runtime_command": ["docker"],
    "image": "qinyuan-tools:nmap-1",
    "network": "bridge",
    "max_output_bytes": 262144,
    "max_artifact_bytes": 8388608,
    "max_command_timeout_seconds": 900,
    "docker_api_timeout_seconds": 960,
    "kill_grace_seconds": 3,
    "memory_limit": "256m",
    "cpu_limit": 1.0,
    "pids_limit": 64
  },
  "coordinator": {
    "max_global_running": 16,
    "max_project_running": 4,
    "max_global_planning": 4,
    "max_project_planning": 2,
    "aging_seconds": 30
  },
  "audit": {
    "max_log_bytes": 8388608,
    "max_retained_log_sets": 500,
    "max_retained_exports": 5,
    "default_log_page_bytes": 262144,
    "max_log_page_bytes": 1048576
  },
  "providers": [
    {
      "name": "codex",
      "enabled": true,
      "priority": 100,
      "max_running": 4,
      "command": [
        "codex",
        "exec",
        "--dangerously-bypass-approvals-and-sandbox",
        "--skip-git-repo-check",
        "--ephemeral",
        "-C",
        "{work_dir}",
        "-"
      ],
      "health_check": {
        "command": [
          "codex",
          "--version"
        ],
        "timeout_seconds": 10,
        "cooldown_seconds": 15,
        "max_cooldown_seconds": 300,
        "failure_threshold": 3
      },
      "planning_timeout_seconds": 120,
      "timeout_seconds": 900,
      "streaming_supported": true
    },
    {
      "name": "claude",
      "enabled": true,
      "priority": 90,
      "max_running": 4,
      "command": [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--include-partial-messages",
        "--dangerously-skip-permissions"
      ],
      "stream_format": "claude-stream-json",
      "streaming_supported": true,
      "health_check": {
        "command": [
          "claude",
          "--version"
        ],
        "timeout_seconds": 10,
        "cooldown_seconds": 15,
        "max_cooldown_seconds": 300,
        "failure_threshold": 3
      },
      "planning_timeout_seconds": 120,
      "timeout_seconds": 900
    },
    {
      "name": "kimi",
      "enabled": true,
      "priority": 80,
      "max_running": 4,
      "command": [
        "kimi",
        "--print"
      ],
      "health_check": {
        "command": [
          "kimi",
          "--version"
        ],
        "timeout_seconds": 10,
        "cooldown_seconds": 15,
        "max_cooldown_seconds": 300,
        "failure_threshold": 3
      },
      "streaming_supported": false,
      "timeout_seconds": 900
    },
    {
      "name": "qinyuan-main",
      "enabled": true,
      "priority": 70,
      "max_running": 2,
      "command": [
        "qinyuan-main"
      ],
      "tool_sandbox_profile": "interactive_unrestricted",
      "provider_isolation": "host_process",
      "host_tools_disabled": false,
      "authorized_targets": [],
      "health_check": {
        "command": [
          "qinyuan-main",
          "--version"
        ],
        "timeout_seconds": 10,
        "cooldown_seconds": 15,
        "max_cooldown_seconds": 300,
        "failure_threshold": 3
      },
      "planning_timeout_seconds": 120,
      "timeout_seconds": 900,
      "streaming_supported": true
    }
  ]
}
