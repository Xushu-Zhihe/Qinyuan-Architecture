{
  "providers": [
    {
      "name": "codex",
      "enabled": true,
      "priority": 100,
      "command": [
        "codex",
        "exec",
        "--dangerously-bypass-approvals-and-sandbox",
        "--skip-git-repo-check",
        "--ephemeral",
        "-C",
        "{work_dir}",
        "-"
      ],
      "health_check": {
        "command": ["codex", "--version"],
        "timeout_seconds": 10,
        "cooldown_seconds": 15,
        "max_cooldown_seconds": 300,
        "failure_threshold": 3
      },
      "planning_timeout_seconds": 120,
      "timeout_seconds": 900
    },
    {
      "name": "claude",
      "enabled": true,
      "priority": 90,
      "command": [
        "claude",
        "-p",
        "--output-format",
        "text",
        "--dangerously-skip-permissions"
      ],
      "health_check": {
        "command": ["claude", "--version"],
        "timeout_seconds": 10,
        "cooldown_seconds": 15,
        "max_cooldown_seconds": 300,
        "failure_threshold": 3
      },
      "planning_timeout_seconds": 120,
      "timeout_seconds": 900
    },
    {
      "name": "kimi",
      "enabled": true,
      "priority": 80,
      "command": ["kimi", "--print"],
      "health_check": {
        "command": ["kimi", "--version"],
        "timeout_seconds": 10,
        "cooldown_seconds": 15,
        "max_cooldown_seconds": 300,
        "failure_threshold": 3
      },
      "timeout_seconds": 900
    }
  ]
}
